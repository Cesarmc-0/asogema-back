<!DOCTYPE html>
<html lang="es">
  <body style="font-family: Arial, sans-serif; color: #222; line-height: 1.6">
    <h2 style="color: #1a5fb4">Reserva de salón confirmada</h2>
    <p>Hola {{nombre}}, tu reserva de salón fue registrada con éxito.</p>
    <table style="border-collapse: collapse; margin-top: 12px">
      <tr>
        <td style="padding: 6px 12px; font-weight: bold">N° reserva:</td>
        <td style="padding: 6px 12px">{{reserva_id}}</td>
      </tr>
      <tr>
        <td style="padding: 6px 12px; font-weight: bold">Salón:</td>
        <td style="padding: 6px 12px">{{servicio}}</td>
      </tr>
      <tr>
        <td style="padding: 6px 12px; font-weight: bold">Tipo de evento:</td>
        <td style="padding: 6px 12px">{{detalle}}</td>
      </tr>
      <tr>
        <td style="padding: 6px 12px; font-weight: bold">Fecha:</td>
        <td style="padding: 6px 12px">{{fecha}}</td>
      </tr>
      {{#if hora}}
      <tr>
        <td style="padding: 6px 12px; font-weight: bold">Horario:</td>
        <td style="padding: 6px 12px">{{hora}}</td>
      </tr>
      {{/if}}
      {{#if personas}}
      <tr>
        <td style="padding: 6px 12px; font-weight: bold">Personas:</td>
        <td style="padding: 6px 12px">{{personas}}</td>
      </tr>
      {{/if}}
      {{#if total}}
      <tr>
        <td style="padding: 6px 12px; font-weight: bold">Anticipo:</td>
        <td style="padding: 6px 12px">$ {{total}}</td>
      </tr>
      {{/if}}
    </table>
    <p style="color: #666; font-size: 14px">
      Tu reserva está pendiente de confirmación. Te contactaremos para coordinar
      los detalles.
    </p>
  </body>
</html>
