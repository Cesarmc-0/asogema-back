# PostgreSQL (Relacional)
# Local:  postgresql://postgres:postgres@localhost:5432/railway
# Cloud:  postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/railway"

# MongoDB (configuraciones del sistema) — opcional, deshabilita ConfiguracionesModule si no está seteado
# MONGODB_URI="mongodb://localhost:27017/asogema_mongo"

# Redis (cache, auditoria, reportes, rate limit, colas)
# Local: redis://localhost:6379
# Cloud: redis://default:PASSWORD@HOST:PORT
REDIS_URL="redis://localhost:6379"

# Aplicacion
PORT=3000
NODE_ENV=development
JWT_SECRET="cambiar_por_secreto_seguro"

# Tokens
# Access token: vida corta (5-15 min recomendado)
JWT_EXPIRES_IN="15m"
# Refresh token: vida larga (dias/semanas)
JWT_REFRESH_EXPIRES_IN="7d"

# Resend (envío de correo - dominio verificado para evitar spam)
# Obtén la API key en https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxx"
# Debe usar un dominio verificado en Resend (con SPF/DKIM/DMARC configurados)
RESEND_FROM="Asogema <no-reply@asogema.com>"

# Reportes - administradores que reciben el reporte global
MAIL_REPORT_RECIPIENTS=admin@asogema.com

# Cron schedule (formato cron) - default 9:00 AM lunes a sábado
MAIL_REPORT_CRON="0 9 * * 1-6"

# Admin (usuario administrador por defecto)
# Solo se usa en seed y en CreateAdminService al iniciar la app
ADMIN_EMAIL="admin@asogema.com"
ADMIN_PASSWORD="Admin123456"

# Wompi (pasarela de pagos)
# Sandbox: https://sandbox.wompi.co  |  Produccion: https://api.wompi.co
WOMPI_PUBLIC_KEY="pub_test_xxx"
WOMPI_PRIVATE_KEY="prv_test_xxx"
WOMPI_EVENT_SECRET="whsec_test_xxx"
WOMPI_API_URL="https://sandbox.wompi.co/v1"
# Secreto de integridad (Dashboard > Settings > Security)
WOMPI_INTEGRITY_SECRET="integrity_secret_xxx"
# URL del frontend para redirect post-pago
FRONTEND_URL="http://localhost:5173"

# Factus (facturacion electronica DIAN)
# Sandbox: api-sandbox  |  Produccion: api
FACTUS_API_URL="https://api-sandbox.factus.com.co"
FACTUS_API_KEY="tu_api_key"
FACTUS_CLIENT_ID="tu_client_id"
FACTUS_ENV="sandbox"

# AWS S3 (imagenes del panel admin)
AWS_REGION="us-east-1"
AWS_S3_BUCKET="datos"
AWS_ACCESS_KEY_ID="datos"
AWS_SECRET_ACCESS_KEY="datos"
# Opcional: dominio publico (ej. CloudFront). Default: https://<bucket>.s3.<region>.amazonaws.com
# AWS_S3_PUBLIC_BASE_URL="https://cdn.asogema.com"