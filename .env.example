# PostgreSQL (Relacional)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Redis (cache, auditoria, reportes, rate limit, colas)
# Local: redis://localhost:6379
# Cloud: redis://default:PASSWORD@HOST:PORT
REDIS_URL="redis://localhost:6379"

# Aplicacion
PORT=3000
NODE_ENV=development
JWT_SECRET="cambiar_por_secreto_seguro"

# Admin (usuario administrador por defecto)
# Solo se usa en seed y en CreateAdminService al iniciar la app
ADMIN_EMAIL="admin@asogema.com"
ADMIN_PASSWORD="Admin123456"